{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "buildplugin",
            "type": "process",
            "command": "py",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "args": [
                "../../pluginpack.py",
                "--with-version",
                "--mask",
                "(?i)(^|[\\\\/])tests?([\\\\/]|$)|\\.zip$"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
